[Unit]
Description=revproxy - 带后台管理的反向代理
Documentation=https://github.com/yourname/revproxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/revproxy -config /etc/revproxy/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
LimitNOFILE=1048576
LimitNPROC=65535
WorkingDirectory=/etc/revproxy
StandardOutput=journal
StandardError=journal
SyslogIdentifier=revproxy
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15

# 安全加固（按需注释）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
